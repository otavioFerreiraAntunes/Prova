<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Pequenos Passos</title>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: #000000;
      color: #ffffff;
      min-height: 100vh;
      line-height: 1.5;
    }

    header {
      background-color: #070d18;
      border-bottom: 1px solid #14233c;
      padding: 16px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background-color: #0f1e36;
      border: 1px solid #1e3a5f;
      color: #ffffff;
    }

    header h1 {
      font-size: 1.15rem;
      font-weight: 600;
      color: #ffffff;
      letter-spacing: -0.01em;
    }

    .usuario {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 0.9rem;
      color: #94a3b8;
    }

    .usuario strong {
      color: #ffffff;
    }

    nav {
      background-color: #0a1322;
      border-bottom: 1px solid #14233c;
      padding: 10px 36px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    nav a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #94a3b8;
      padding: 8px 18px;
      border-radius: 6px;
      font-size: 0.88rem;
      font-weight: 500;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    nav a:hover {
      background-color: #0f1e36;
      color: #ffffff;
    }

    nav a.ativo {
      background-color: #0f1e36;
      color: #ffffff;
      border-color: #ffffff;
    }

    main {
      max-width: 1140px;
      margin: 32px auto;
      padding: 0 24px;
    }

    .boas-vindas {
      margin-bottom: 28px;
    }

    .boas-vindas h2 {
      font-size: 1.6rem;
      color: #ffffff;
    }

    .sub-info {
      color: #94a3b8;
      font-size: 0.88rem;
      margin-top: 4px;
    }

    .btn-sair {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      background-color: #070d18;
      color: #94a3b8;
      border: 1px solid #1e3a5f;
      padding: 7px 14px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    .btn-sair:hover {
      background-color: #0f1e36;
      color: #ffffff;
      border-color: #ffffff;
    }

    .modulos-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }

    .modulo-card {
      background-color: #070d18;
      border: 1px solid #14233c;
      border-radius: 12px;
      padding: 24px;
      display: flex;
      align-items: center;
      gap: 18px;
      text-decoration: none;
      color: #ffffff;
      transition: all 0.2s ease;
    }

    .modulo-card:hover {
      background-color: #0a1322;
      border-color: #ffffff;
      transform: translateY(-2px);
    }

    .modulo-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: 10px;
      flex-shrink: 0;
      background-color: #0f1e36;
      border: 1px solid #1e3a5f;
      color: #ffffff;
    }

    .modulo-info h3 {
      font-size: 1.05rem;
      font-weight: 600;
      color: #ffffff;
      margin-bottom: 4px;
    }

    .modulo-info p {
      font-size: 0.84rem;
      color: #94a3b8;
    }

    .modulo-arrow {
      margin-left: auto;
      color: #64748b;
      transition: transform 0.2s ease, color 0.2s ease;
    }

    .modulo-card:hover .modulo-arrow {
      transform: translateX(4px);
      color: #ffffff;
    }
  </style>
</head>

<body>
  <header>
    <div class="logo-area">
      <div class="logo-badge">
        <i data-lucide="stethoscope" width="20" height="20"></i>
      </div>
      <h1>Clínica Pequenos Passos</h1>
    </div>
    <div class="usuario">
      <span><i data-lucide="user" width="16" height="16" style="vertical-align: middle;"></i>
        <%= usuario.nome %>
      </span>
      <a class="btn-sair" href="/logout">
        <i data-lucide="log-out" width="14" height="14"></i> Sair
      </a>
    </div>
  </header>

  <nav>
    <a href="/dashboard" class="ativo">
      <i data-lucide="layout-dashboard" width="16" height="16"></i> Início
    </a>
    <a href="/responsaveis">
      <i data-lucide="users" width="16" height="16"></i> Responsáveis
    </a>
    <a href="/criancas">
      <i data-lucide="baby" width="16" height="16"></i> Crianças
    </a>
    <a href="/agendamentos">
      <i data-lucide="calendar" width="16" height="16"></i> Agendamentos
    </a>
  </nav>

  <main>
    <div class="boas-vindas">
      <h2>Olá, <%= usuario.nome %>
      </h2>
      <p class="sub-info">Painel administrativo de gestão pediátrica</p>
    </div>

    <div class="modulos-grid">
      <a class="modulo-card" href="/responsaveis">
        <div class="modulo-icon">
          <i data-lucide="users" width="22" height="22"></i>
        </div>
        <div class="modulo-info">
          <h3>Responsáveis</h3>
          <p>Gerenciamento e pesquisa dinâmica</p>
        </div>
        <i data-lucide="chevron-right" width="18" height="18" class="modulo-arrow"></i>
      </a>

      <a class="modulo-card" href="/criancas">
        <div class="modulo-icon">
          <i data-lucide="baby" width="22" height="22"></i>
        </div>
        <div class="modulo-info">
          <h3>Crianças</h3>
          <p>Pacientes infantis vinculados</p>
        </div>
        <i data-lucide="chevron-right" width="18" height="18" class="modulo-arrow"></i>
      </a>

      <a class="modulo-card" href="/agendamentos">
        <div class="modulo-icon">
          <i data-lucide="calendar" width="22" height="22"></i>
        </div>
        <div class="modulo-info">
          <h3>Agendamentos</h3>
          <p>Consultas pediátricas e remarcação</p>
        </div>
        <i data-lucide="chevron-right" width="18" height="18" class="modulo-arrow"></i>
      </a>
    </div>
  </main>

  <script>
    lucide.createIcons();
  </script>
</body>

</html>