<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — Pequenos Passos</title>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: #000000;
      color: #ffffff;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .login-box {
      width: 100%;
      max-width: 420px;
    }

    .brand-header {
      text-align: center;
      margin-bottom: 28px;
    }

    .brand-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      border-radius: 12px;
      background-color: #0f1e36;
      border: 1px solid #1e3a5f;
      color: #ffffff;
      margin-bottom: 14px;
    }

    .brand-header h1 {
      font-size: 1.35rem;
      font-weight: 600;
      color: #ffffff;
      letter-spacing: -0.01em;
    }

    .brand-header p {
      color: #94a3b8;
      font-size: 0.88rem;
      margin-top: 4px;
    }

    .card {
      background-color: #070d18;
      border: 1px solid #14233c;
      border-radius: 12px;
      padding: 32px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    label {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 7px;
      font-size: 0.84rem;
      font-weight: 500;
      color: #cbd5e1;
    }

    input[type="text"],
    input[type="password"] {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid #1e3a5f;
      border-radius: 8px;
      font-size: 0.9rem;
      background-color: #000000;
      color: #ffffff;
      transition: border-color 0.2s ease;
    }

    input:focus {
      outline: none;
      border-color: #ffffff;
    }

    input::placeholder {
      color: #64748b;
    }

    .btn {
      width: 100%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: 1px solid #1e3a5f;
      cursor: pointer;
      padding: 12px;
      margin-top: 8px;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      color: #ffffff;
      background-color: #0f1e36;
      transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .btn:hover {
      background-color: #172d4f;
      border-color: #ffffff;
    }

    .alerta {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 18px;
      font-weight: 600;
      font-size: 0.88rem;
      background-color: #0f1e36;
      color: #ffffff;
      border: 1px solid #ffffff;
    }
  </style>
</head>

<body>
  <div class="login-box">
    <div class="brand-header">
      <div class="brand-icon">
        <i data-lucide="stethoscope" width="28" height="28"></i>
      </div>
      <h1>Clínica Pequenos Passos</h1>
      <p>Acesso restrito a recepcionistas e atendentes</p>
    </div>

    <div class="card">
      <% if (erro) { %>
        <div class="alerta">
          <i data-lucide="alert-circle" width="16" height="16"></i>
          <%= erro %>
        </div>
        <% } %>

          <form action="/login" method="POST">
            <div class="form-group">
              <label for="cpf">
                <i data-lucide="credit-card" width="14" height="14"></i> CPF
              </label>
              <input type="text" id="cpf" name="cpf" placeholder="000.000.000-00" required autofocus>
            </div>

            <div class="form-group">
              <label for="senha">
                <i data-lucide="lock" width="14" height="14"></i> Senha
              </label>
              <input type="password" id="senha" name="senha" placeholder="Sua senha" required>
            </div>

            <button type="submit" class="btn">
              <i data-lucide="log-in" width="16" height="16"></i> Entrar no Sistema
            </button>
          </form>
    </div>
  </div>

  <script>
    lucide.createIcons();
  </script>
</body>

</html>