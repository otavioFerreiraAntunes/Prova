<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nova Criança — Pequenos Passos</title>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: #000000;
      color: #ffffff;
      min-height: 100vh;
      line-height: 1.5;
    }

    header {
      background-color: #070d18;
      border-bottom: 1px solid #14233c;
      padding: 16px 36px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border-radius: 8px;
      background-color: #0f1e36;
      border: 1px solid #1e3a5f;
      color: #ffffff;
    }

    header h1 {
      font-size: 1.15rem;
      font-weight: 600;
      color: #ffffff;
      letter-spacing: -0.01em;
    }

    .usuario {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 0.9rem;
      color: #94a3b8;
    }

    .usuario strong {
      color: #ffffff;
    }

    nav {
      background-color: #0a1322;
      border-bottom: 1px solid #14233c;
      padding: 10px 36px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    nav a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #94a3b8;
      padding: 8px 18px;
      border-radius: 6px;
      font-size: 0.88rem;
      font-weight: 500;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    nav a:hover {
      background-color: #0f1e36;
      color: #ffffff;
    }

    nav a.ativo {
      background-color: #0f1e36;
      color: #ffffff;
      border-color: #ffffff;
    }

    main {
      max-width: 1140px;
      margin: 32px auto;
      padding: 0 24px;
    }

    .card {
      background-color: #070d18;
      border: 1px solid #14233c;
      border-radius: 12px;
      padding: 28px;
    }

    .form-container {
      max-width: 680px;
      margin: 0 auto;
    }

    .topo {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 22px;
    }

    h2 {
      color: #ffffff;
      font-size: 1.35rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .sub-info {
      color: #94a3b8;
      font-size: 0.88rem;
      margin-top: 4px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    label {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 7px;
      font-size: 0.84rem;
      font-weight: 500;
      color: #cbd5e1;
    }

    input[type="text"],
    input[type="date"],
    select {
      width: 100%;
      padding: 11px 14px;
      border: 1px solid #1e3a5f;
      border-radius: 8px;
      font-size: 0.9rem;
      font-family: inherit;
      background-color: #000000;
      color: #ffffff;
      transition: border-color 0.2s ease;
    }

    input:focus,
    select:focus {
      outline: none;
      border-color: #ffffff;
    }

    input::placeholder {
      color: #64748b;
    }

    .botoes-form {
      margin-top: 26px;
      display: flex;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: 1px solid #1e3a5f;
      cursor: pointer;
      text-decoration: none;
      padding: 9px 18px;
      border-radius: 6px;
      font-size: 0.88rem;
      font-weight: 500;
      color: #ffffff;
      background-color: #0f1e36;
      transition: all 0.2s ease;
    }

    .btn:hover {
      background-color: #172d4f;
      border-color: #ffffff;
    }

    .btn-novo {
      background-color: #0f1e36;
      border-color: #ffffff;
    }

    .btn-novo:hover {
      background-color: #ffffff;
      color: #000000;
    }

    .btn-cinza {
      background-color: #000000;
      color: #94a3b8;
      border: 1px solid #1e3a5f;
    }

    .btn-cinza:hover {
      background-color: #0f1e36;
      color: #ffffff;
      border-color: #ffffff;
    }

    .btn-sair {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      background-color: #070d18;
      color: #94a3b8;
      border: 1px solid #1e3a5f;
      padding: 7px 14px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 500;
      transition: all 0.2s ease;
    }

    .btn-sair:hover {
      background-color: #0f1e36;
      color: #ffffff;
      border-color: #ffffff;
    }

    .alerta {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      border-radius: 8px;
      margin-bottom: 18px;
      font-weight: 600;
      font-size: 0.88rem;
      background-color: #0f1e36;
      color: #ffffff;
      border: 1px solid #ffffff;
    }
  </style>
</head>

<body>
  <header>
    <div class="logo-area">
      <div class="logo-badge">
        <i data-lucide="stethoscope" width="20" height="20"></i>
      </div>
      <h1>Clínica Pequenos Passos</h1>
    </div>
    <div class="usuario">
      <span><i data-lucide="user" width="16" height="16" style="vertical-align: middle;"></i>
        <%= usuario.nome %>
      </span>
      <a class="btn-sair" href="/logout">
        <i data-lucide="log-out" width="14" height="14"></i> Sair
      </a>
    </div>
  </header>

  <nav>
    <a href="/dashboard">
      <i data-lucide="layout-dashboard" width="16" height="16"></i> Início
    </a>
    <a href="/responsaveis">
      <i data-lucide="users" width="16" height="16"></i> Responsáveis
    </a>
    <a href="/criancas" class="ativo">
      <i data-lucide="baby" width="16" height="16"></i> Crianças
    </a>
    <a href="/agendamentos">
      <i data-lucide="calendar" width="16" height="16"></i> Agendamentos
    </a>
  </nav>

  <main>
    <div class="card form-container">
      <div class="topo">
        <div>
          <h2><i data-lucide="plus-circle" width="22" height="22"></i> Cadastrar Nova Criança</h2>
          <p class="sub-info">Vincule a criança a um responsável existente (RN07)</p>
        </div>
      </div>

      <% if (typeof mensagem !=='undefined' && mensagem) { %>
        <div class="alerta">
          <i data-lucide="info" width="16" height="16"></i>
          <%= mensagem.texto %>
        </div>
        <% } %>

          <form action="/criancas/nova" method="POST">
            <div class="form-group">
              <label for="nome">
                <i data-lucide="baby" width="14" height="14"></i> Nome Completo da Criança *
              </label>
              <input type="text" id="nome" name="nome" value="<%= dados.nome || '' %>" required>
            </div>

            <div class="form-group">
              <label for="data_nascimento">
                <i data-lucide="calendar" width="14" height="14"></i> Data de Nascimento *
              </label>
              <input type="date" id="data_nascimento" name="data_nascimento" value="<%= dados.data_nascimento || '' %>"
                required>
            </div>

            <div class="form-group">
              <label for="responsavel_id">
                <i data-lucide="users" width="14" height="14"></i> Responsável Obrigatório *
              </label>
              <select id="responsavel_id" name="responsavel_id" required>
                <option value="">Selecione um responsável cadastrado...</option>
                <% responsaveis.forEach(function(r) { %>
                  <option value="<%= r.id %>" <%=String(dados.responsavel_id)===String(r.id) ? 'selected' : '' %>>
                    <%= r.nome %>
                  </option>
                  <% }); %>
              </select>
            </div>

            <div class="botoes-form">
              <button type="submit" class="btn btn-novo">
                <i data-lucide="check" width="16" height="16"></i> Cadastrar Criança
              </button>
              <a class="btn btn-cinza" href="/criancas">
                <i data-lucide="x" width="16" height="16"></i> Cancelar
              </a>
            </div>
          </form>
    </div>
  </main>

  <script>
    lucide.createIcons();
  </script>
</body>

</html>